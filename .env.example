# The ONLY GitLab origin this application will contact. HTTPS is required.
# The application refuses to start if this is malformed.
GITLAB_ORIGIN=https://gitlab.com

# Default link mode shares no GitLab metadata and makes no GitLab API calls.
# metadata explicitly allows the sender to publish fetched details to EVERY
# conversation reader. GitLab permissions do not protect a posted Teams card.
PREVIEW_MODE=link

# Required and nonempty for metadata mode; optional for link mode.
# Approve these prefixes for disclosure into Teams. No wildcard or URL syntax.
# `company/platform` allows `company/platform/api`, never `company/platform-evil`.
# PROJECT_ALLOWLIST=company/platform,company/infra

# Azure Bot registration. Both values must be GUIDs, including in link mode.
BOT_ID=
BOT_TENANT_ID=

# Required only in metadata mode. In production supply this through your platform's secret manager
# (AWS Secrets Manager, Azure Key Vault, GCP Secret Manager), never as a
# literal in a deployment manifest, a container image or CI logs.
BOT_PASSWORD=

# Microsoft public cloud: token.botframework.com, europe.token.botframework.com,
# unitedstates.token.botframework.com or india.token.botframework.com. Must match
# the GitLab OAuth redirect URI and the domain used when building the manifest.
OAUTH_ORIGIN=https://token.botframework.com

# The name of the OAuth connection on the Azure Bot resource.
OAUTH_CONNECTION_NAME=gitlab

# Required when building the Teams ZIP, not for the runtime.
# Use real internal publisher/support, privacy, and terms pages.
DEVELOPER_NAME=
WEBSITE_URL=
PRIVACY_URL=
TERMS_URL=
# Increase for every updated Teams package; preserve BOT_ID across upgrades.
APP_VERSION=0.1.0
